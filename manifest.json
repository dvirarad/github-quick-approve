{
  "manifest_version": 3,
  "name": "GitHub Quick Approve",
  "version": "1.0.0",
  "description": "One-click approve button on GitHub pull requests.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "GitHub Quick Approve: settings"
  }
}
